{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/authority/v0.1",
  "title": "Typikon rule authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "kind"],
  "properties": {
    "schema": { "const": "typikon.authority/v0.1" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["authoritative", "observed_behavior"] },
    "publisher": { "type": "string", "minLength": 1 },
    "locator": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "accessed": { "type": "string", "format": "date" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" }
  }
}
