{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/ffi-response/v0.1",
  "title": "Typikon native ABI response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok"],
  "properties": {
    "schema": { "const": "typikon.ffi-response/v0.1" },
    "ok": { "type": "boolean" },
    "plan": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "message": { "type": "string" }
      }
    }
  },
  "oneOf": [
    {
      "properties": { "ok": { "const": true } },
      "required": ["plan"],
      "not": { "required": ["error"] }
    },
    {
      "properties": { "ok": { "const": false } },
      "required": ["error"],
      "not": { "required": ["plan"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" }
  }
}
