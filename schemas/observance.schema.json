{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/observance/v0.3",
  "title": "Typikon observance definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "date", "rank"],
  "properties": {
    "schema": { "const": "typikon.observance/v0.3" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "date": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixed"],
          "properties": {
            "fixed": {
              "type": "object",
              "additionalProperties": false,
              "required": ["month", "day"],
              "properties": {
                "month": { "type": "integer", "minimum": 1, "maximum": 12 },
                "day": { "type": "integer", "minimum": 1, "maximum": 31 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["paschal_offset"],
          "properties": {
            "paschal_offset": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647,
              "description": "Elapsed days from calculated Orthodox Pascha"
            }
          }
        }
      ]
    },
    "rank": { "$ref": "#/$defs/id" },
    "authority": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "appointments": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": { "$ref": "#/$defs/id" },
        "additionalProperties": { "$ref": "#/$defs/oneOrMany" }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "oneOrMany": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      ]
    }
  }
}
