{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/observance/v0.4",
  "title": "Typikon observance definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "date", "rank"],
  "properties": {
    "schema": { "const": "typikon.observance/v0.4" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "date": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixed"],
          "properties": {
            "fixed": {
              "type": "object",
              "additionalProperties": false,
              "required": ["month", "day"],
              "properties": {
                "month": { "type": "integer", "minimum": 1, "maximum": 12 },
                "day": { "type": "integer", "minimum": 1, "maximum": 31 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["paschal_offset"],
          "properties": {
            "paschal_offset": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647,
              "description": "Elapsed days from calculated Orthodox Pascha"
            }
          }
        }
      ]
    },
    "rank": { "$ref": "#/$defs/id" },
    "authority": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "common": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/material" }
    },
    "services": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/id" },
        "additionalProperties": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/selection" }
        }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "attribute": {
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/scalar" } }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/id" },
        "reference": { "$ref": "#/$defs/reference" },
        "authority": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/attribute" }
        }
      }
    },
    "localReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use"],
      "properties": {
        "use": { "type": "string", "pattern": "^common\\.[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" }
      }
    },
    "materialUse": {
      "oneOf": [
        { "$ref": "#/$defs/material" },
        { "$ref": "#/$defs/localReference" }
      ]
    },
    "selection": {
      "oneOf": [
        { "$ref": "#/$defs/materialUse" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/materialUse" } }
      ]
    }
  }
}
