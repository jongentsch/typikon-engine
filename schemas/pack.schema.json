{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/pack/v0.2",
  "title": "Typikon tradition pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "calendar", "definitions"],
  "properties": {
    "schema": { "const": "typikon.pack/v0.2" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed", "paschalion", "tone_cycle"],
      "properties": {
        "fixed": { "enum": ["gregorian", "julian", "revised_julian"] },
        "paschalion": { "enum": ["orthodox_julian"] },
        "tone_cycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "tones"],
          "properties": {
            "system": { "const": "octoechos" },
            "tones": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["services", "observances", "resources", "rules", "authorities"],
      "properties": {
        "services": { "$ref": "#/$defs/path" },
        "observances": { "$ref": "#/$defs/path" },
        "resources": { "$ref": "#/$defs/path" },
        "rules": { "$ref": "#/$defs/path" },
        "authorities": { "$ref": "#/$defs/path" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
  }
}
