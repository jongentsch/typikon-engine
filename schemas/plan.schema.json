{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/plan/v0.2",
  "title": "Compiled Typikon service plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "engine_version", "status", "pack", "request", "day", "derivations", "observances", "sections", "decisions"],
  "properties": {
    "schema": { "const": "typikon.plan/v0.2" },
    "engine_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["complete", "requires_review"] },
    "form": { "$ref": "#/$defs/id" },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string" } }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "civil_date", "service", "observances"],
      "properties": {
        "schema": { "const": "typikon.request/v0.1" },
        "civil_date": { "type": "string", "format": "date" },
        "service": { "$ref": "#/$defs/id" },
        "tone": { "$ref": "#/$defs/id" },
        "phase": { "enum": ["ordinary", "triodion", "pentecostarion"] },
        "observances": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liturgical_date", "fixed_date", "fixed_calendar", "pascha", "weekday", "tone", "phase"],
      "properties": {
        "liturgical_date": { "type": "string", "format": "date" },
        "fixed_date": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$" },
        "fixed_calendar": { "enum": ["gregorian", "julian", "revised_julian"] },
        "pascha": { "type": "string", "format": "date" },
        "weekday": { "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] },
        "tone": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "phase": { "enum": ["ordinary", "triodion", "pentecostarion"] }
      }
    },
    "derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "component", "method", "inputs", "output"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "component": { "$ref": "#/$defs/id" },
          "method": { "$ref": "#/$defs/id" },
          "inputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } },
          "output": { "$ref": "#/$defs/scalar" }
        }
      }
    },
    "observances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "rank"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "rank": { "$ref": "#/$defs/id" },
          "selection_derivation": { "$ref": "#/$defs/id" }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "components"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "kind", "status", "materials"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "name": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["fixed", "changeable"] },
                "status": { "enum": ["resolved", "omitted", "unresolved"] },
                "materials": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["material"],
                    "properties": {
                      "material": { "$ref": "#/$defs/material" },
                      "count": { "type": "integer", "minimum": 1 },
                      "decision": { "$ref": "#/$defs/id" },
                      "observance": { "$ref": "#/$defs/id" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule", "authority"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "rule": { "$ref": "#/$defs/id" },
          "authority": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "observance": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "attribute": { "oneOf": [{ "$ref": "#/$defs/scalar" }, { "type": "array", "items": { "$ref": "#/$defs/scalar" } }] },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/id" },
        "reference": { "$ref": "#/$defs/reference" },
        "authority": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/attribute" } }
      }
    }
  }
}
