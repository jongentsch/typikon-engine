{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/rank/v0.1",
  "title": "Typikon rank profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "authority", "services"],
  "properties": {
    "schema": { "const": "typikon.rank/v0.1" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required"],
        "properties": {
          "required": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["section", "component"],
              "properties": {
                "section": { "$ref": "#/$defs/id" },
                "component": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" }
  }
}
