{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/resource/v0.1",
  "title": "Typikon liturgical resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "kind", "role", "authority", "reference"],
  "properties": {
    "schema": { "const": "typikon.resource/v0.1" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "$ref": "#/$defs/id" },
    "role": { "$ref": "#/$defs/id" },
    "authority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "accessed": { "type": "string", "format": "date" }
      }
    },
    "properties": {
      "type": "object",
      "propertyNames": {
        "not": { "enum": ["source", "resource", "title", "kind", "role", "reference", "accessed", "observance"] }
      },
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" },
    "scalar": { "type": ["string", "number", "boolean", "null"] }
  }
}
