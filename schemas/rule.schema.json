{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/rule/v0.2",
  "title": "Typikon rule definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "when", "emit"],
  "properties": {
    "schema": { "const": "typikon.rule/v0.2" },
    "id": { "$ref": "#/$defs/id" },
    "when": { "$ref": "#/$defs/whenPredicate" },
    "unless": { "$ref": "#/$defs/predicate" },
    "emit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "slot"],
        "oneOf": [
          { "required": ["material"] },
          { "required": ["appointment"] }
        ],
        "properties": {
          "section": { "$ref": "#/$defs/id" },
          "slot": { "$ref": "#/$defs/id" },
          "material": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/$defs/scalar" }
          },
          "appointment": { "$ref": "#/$defs/id" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "authority": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "oneOrMany": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      ]
    },
    "dayPredicate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "weekday": { "$ref": "#/$defs/oneOrMany" },
        "phase": { "$ref": "#/$defs/oneOrMany" }
      }
    },
    "observancePredicate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "id": { "$ref": "#/$defs/oneOrMany" },
        "rank": { "$ref": "#/$defs/oneOrMany" },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "service": { "$ref": "#/$defs/id" },
        "day": { "$ref": "#/$defs/dayPredicate" },
        "observance": { "$ref": "#/$defs/observancePredicate" }
      }
    },
    "whenPredicate": {
      "allOf": [
        { "$ref": "#/$defs/predicate" },
        { "required": ["service"] }
      ]
    }
  }
}
