{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/rule/v0.3",
  "title": "Typikon rule definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "when"],
  "anyOf": [
    { "required": ["emit"] },
    { "required": ["select_form"] }
  ],
  "properties": {
    "schema": { "const": "typikon.rule/v0.3" },
    "id": { "$ref": "#/$defs/id" },
    "when": { "$ref": "#/$defs/whenPredicate" },
    "unless": { "$ref": "#/$defs/predicate" },
    "select_form": { "$ref": "#/$defs/id" },
    "emit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "component"],
        "oneOf": [
          { "required": ["material"] },
          { "required": ["observance"] }
        ],
        "properties": {
          "section": { "$ref": "#/$defs/id" },
          "component": { "$ref": "#/$defs/id" },
          "material": { "$ref": "#/$defs/material" },
          "observance": { "const": true },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "authority": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "attribute": {
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/scalar" } }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/id" },
        "reference": { "$ref": "#/$defs/reference" },
        "authority": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/attribute" } }
      }
    },
    "oneOrMany": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      ]
    },
    "dayPredicate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "weekday": { "$ref": "#/$defs/oneOrMany" },
        "phase": { "$ref": "#/$defs/oneOrMany" }
      }
    },
    "observancePredicate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "id": { "$ref": "#/$defs/oneOrMany" },
        "rank": { "$ref": "#/$defs/oneOrMany" },
        "properties": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/scalar" } }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "service": { "$ref": "#/$defs/id" },
        "day": { "$ref": "#/$defs/dayPredicate" },
        "observance": { "$ref": "#/$defs/observancePredicate" }
      }
    },
    "whenPredicate": {
      "allOf": [
        { "$ref": "#/$defs/predicate" },
        { "required": ["service"] }
      ]
    }
  }
}
