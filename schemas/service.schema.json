{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/service/v0.2",
  "title": "Typikon service definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "liturgical_day_offset", "authority", "sections"],
  "properties": {
    "schema": { "const": "typikon.service/v0.2" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "liturgical_day_offset": { "type": "integer", "minimum": -1, "maximum": 1 },
    "authority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "default_form": { "$ref": "#/$defs/id" },
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "authority"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "authority": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "components"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/component" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "attribute": {
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/scalar" } }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/id" },
        "reference": { "$ref": "#/$defs/reference" },
        "authority": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/attribute" }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "oneOf": [
        {
          "properties": { "kind": { "const": "fixed" } },
          "required": ["material"]
        },
        {
          "properties": { "kind": { "const": "changeable" } },
          "required": ["cardinality"]
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["fixed", "changeable"] },
        "cardinality": { "enum": ["many", "optional", "one"] },
        "accepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "material": { "$ref": "#/$defs/material" },
        "form_material": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/material" }
        }
      }
    }
  }
}
