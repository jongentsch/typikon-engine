{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typikon.dev/schema/service/v0.1",
  "title": "Typikon service definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "liturgical_day_offset", "sections"],
  "properties": {
    "schema": { "const": "typikon.service/v0.1" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "liturgical_day_offset": { "type": "integer", "minimum": -1, "maximum": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slots"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "cardinality"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "cardinality": { "enum": ["many", "optional", "one"] }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9_-]*[a-z0-9])?$" }
  }
}
